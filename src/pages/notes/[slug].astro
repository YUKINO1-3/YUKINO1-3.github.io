---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import "katex/dist/katex.min.css";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const publishedNotes = await getCollection("notes", ({ data }) => data.lifecycle === "published");

  return Promise.all(publishedNotes.map(async (note) => {
    const { Content } = await render(note);
    return { params: { slug: note.data.slug }, props: { note, Content } };
  }));
}) satisfies GetStaticPaths;

const { note, Content } = Astro.props;
const { data } = note;
---

<BaseLayout title={data.title} description={data.summary}>
  <article class="note-detail">
    <header class="note-header">
      <a class="note-back" href="/notes/">Notes</a>
      <h1>{data.title}</h1>
      <p class="note-summary">{data.summary}</p>
      <dl class="note-facts">
        <div><dt>Published</dt><dd><time datetime={data.date.toISOString()}>{data.date.toLocaleDateString("en-GB", { dateStyle: "long" })}</time></dd></div>
        <div><dt>Subject</dt><dd>{data.subject}</dd></div>
        <div><dt>Medium</dt><dd>{data.media.join(", ")}</dd></div>
        <div><dt>Capability</dt><dd>{data.capabilities.join(", ")}</dd></div>
      </dl>
    </header>
    <div class="note-body"><Content /></div>
  </article>
</BaseLayout>
