---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import "katex/dist/katex.min.css";
import NoteArticle from "../../components/NoteArticle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const publishedNotes = await getCollection("notes", ({ data }) => data.lifecycle === "published");

  return Promise.all(publishedNotes.map(async (note) => {
    const { Content } = await render(note);
    return { params: { slug: note.data.slug }, props: { note, Content } };
  }));
}) satisfies GetStaticPaths;

const { note, Content } = Astro.props;
---

<BaseLayout title={note.data.title} description={note.data.summary}>
  <NoteArticle note={note} Content={Content} backHref="/notes/" backLabel="Notes" />
</BaseLayout>
