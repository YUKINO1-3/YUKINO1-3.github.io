---
import PlotMotif from "../components/PlotMotif.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Home"
  description="A technical preview for an evidence-led admissions portfolio."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Exploring ideas through mathematics and computation.</h1>
      <p>Technical preview — authentic work, notes, and academic results will appear only after review.</p>
    </div>
    <div class="hero-plot">
      <PlotMotif />
    </div>
  </section>

  <section class="evidence-section" aria-labelledby="evidence-title">
    <h2 id="evidence-title">A portfolio built around evidence</h2>
    <div class="section-copy">
      <p>This Portfolio will connect every Capability to completed Work or Notes.</p>
      <p>Until those materials are reviewed, this preview shows structure only—not claims, scores, or unfinished projects.</p>
    </div>
  </section>

  <section class="activity-section" aria-labelledby="activity-title">
    <h2 id="activity-title">Recent activity</h2>
    <div class="empty-state">
      <span class="empty-mark" aria-hidden="true"></span>
      <div>
        <p class="empty-title">No published activity yet.</p>
        <p>Work, Notes, and Academic Results will appear here only after review.</p>
      </div>
    </div>
  </section>
</BaseLayout>
